{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Metrics",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/isaac_lab_server_spot_metrics.py",
            "console": "integratedTerminal",
            "args": [
                "--episode_folder",
                "${workspaceFolder}/episodes/",
                "--episode_label",
                // "vc_austin_0",
                // "test_generator_0",
                // "nv_parkmorning_3",
                "nv_apartment_17",
                // "grCommercial_hospital_0",
                "--enable_cameras",
                "--foxglove_port",
                "4924",
            ],
        },
        {
            "name": "Task Generation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/isaac_lab_server_spot_task_generation.py",
            "console": "integratedTerminal",
            "args": [
                "--enable_cameras",
                "--tg_config_path",
                "${workspaceFolder}/episodes/task_config.yaml",
                "--test_scene_id",
                "nv_apartment"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Warmup",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/warmup.py",
            "console": "integratedTerminal",
            "args": [
                "--dirs",
                "/data/isaac_scenes_v1",
                "--enable_cameras"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Path Planning",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/isaac_lab_server_spot_path.py",
            "console": "integratedTerminal",
            "args": [
                "--enable_cameras",
                "--scene_path",
                "/home/junzhewu/data/isaac_scenes_v1/nvidia/AECDemo_NVD@10012/Demos/AEC/BrownstoneDemo/test.usd",
                // "/data/isaac_scenes_v1/nvidia/park_morning/park_morning_edit.usd",
                "--navmesh_path",
                "${workspaceFolder}/episodes/navmesh.bin"
            ],
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
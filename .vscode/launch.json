{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Metrics",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/isaac_lab_server_spot_metrics.py",
            "console": "integratedTerminal",
            "args": [
                "--episode_folder",
                "${workspaceFolder}/episodes/",
                "--host",
                "0.0.0.0",
                "--port",
                "11100",
                "--timeout",
                "123",
            ],
        },
        {
            "name": "Task Generation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/isaac_lab_server_spot_task_generation.py",
            "console": "integratedTerminal",
            "args": [
                "--tg_config_path",
                "${workspaceFolder}/episodes/task_config.yaml",
                "--test_scene_id",
                // "nv_apartment"
                // "grHome_scene12"
                "innout_amsterdam",
                // "vc_amsterdam",
                "--tg_mode",
                "manual"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Train Policy",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/policy/train.py",
            "console": "integratedTerminal",
            "args": [
                "--task",
                "Isaac-Velocity-Rough-Spot-v0",
                "--num_envs",
                "10",
                "--enable_cameras"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Path Planning",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/isaac_lab_server_spot_path.py",
            "console": "integratedTerminal",
            "args": [
                "--enable_cameras",
                "--scene_path",
                "/home/junzhewu/data/isaac_scenes_v1/nvidia/AECDemo_NVD@10012/Demos/AEC/BrownstoneDemo/test.usd",
                // "/data/isaac_scenes_v1/nvidia/park_morning/park_morning_edit.usd",
                "--navmesh_path",
                "${workspaceFolder}/episodes/navmesh.bin"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
    ]
}
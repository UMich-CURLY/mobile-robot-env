   "source": [
    "import numpy as np\n",
    "obs = np.load(\"results/obs_1.npy\")\n",
    "print(obs.shape)\n",
    "import matplotlib.pyplot as plt\n",
    "for i in range(obs.shape[0]):\n",
    "    plt.imshow(obs[i, :, :, :3]/255.)\n",
    "    plt.show()\n",
    "    plt.imsave(f\"results/obs_{i}.png\", obs[i, :, :, :3]/255.)"
   ]
